{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cduestc-spark-proxy",
  "main": "workers/spark-proxy.js",
  "compatibility_date": "2026-06-02",
  "account_id": "7ef8aafe1079e9fe3f1ba233a2396454",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "spark-api.kcos.club",
      "custom_domain": true
    }
  ],
  "vars": {
    "SPARK_ALLOWED_ORIGINS": "https://wiki.kcos.club,http://127.0.0.1:5175",
    "SPARK_OPENAI_URL": "https://spark-api-open.xf-yun.com/v1/chat/completions",
    "SPARK_MODEL": "generalv3.5",
    "SPARK_FALLBACK_URL": "https://spark-api-open.xf-yun.com/v2/chat/completions",
    "SPARK_FALLBACK_MODEL": "spark-x"
  },
  "analytics_engine_datasets": [
    {
      "binding": "AI_TELEMETRY",
      "dataset": "cduestc_ai_telemetry"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

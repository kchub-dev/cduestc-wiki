# Active AI provider: openai or spark
VITE_AI_PROVIDER=openai

# OpenAI-compatible backend proxy. Keep the upstream API key on the backend.
VITE_OPENAI_PROXY_URL=https://example.com/api/ai/openai
VITE_OPENAI_MODEL=step-3.5-flash

# Spark demo. The auth endpoint must return { "url": "wss://...", "appId": "..." }.
# Keep the Spark API key and secret on the signing service, never in VITE_* variables.
VITE_SPARK_AUTH_URL=http://127.0.0.1:8787/spark/auth

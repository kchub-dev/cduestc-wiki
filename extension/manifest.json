{
  "manifest_version": 3,
  "name": "科成星球 AI 直连助手",
  "version": "0.2.3",
  "description": "在科成星球 Wiki 上使用你自己登录的 DeepSeek / 豆包网页账号进行知识问答。请求只发生在你自己的浏览器里，回答内容只发给你自己。",
  "permissions": [
    "cookies",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wiki.kcos.club/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content-deepseek.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.doubao.com/*"
      ],
      "js": [
        "content-doubao.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "科成星球 AI 直连助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
